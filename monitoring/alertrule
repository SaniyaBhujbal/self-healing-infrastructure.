groups:
  - name: nginx-health
    rules:
      - alert: NginxDown
        expr: probe_success{job="blackbox-nginx"} == 0
        for: 20s
        labels:
          severity: critical
          service: nginx
        annotations:
          summary: "NGINX HTTP probe failed"
          description: "NGINX at {{ $labels.instance }} has failed its HTTP health check."
