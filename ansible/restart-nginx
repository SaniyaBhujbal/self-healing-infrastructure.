---
- name: Recover NGINX after monitoring alert
  hosts: localhost
  connection: local
  become: true
  gather_facts: false
  tasks:
    - name: Ensure NGINX is running
      ansible.builtin.service:
        name: nginx
        state: started
        enabled: true

    - name: Verify NGINX responds locally
      ansible.builtin.uri:
        url: http://127.0.0.1/
        method: GET
        status_code: 200
        return_content: false
